# Application Configuration
PROJECT_NAME=MAILSPECTRA
APP_ENV=development
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL compatible, defaults to SQLite for local development)
DATABASE_URL=sqlite+aiosqlite:///./deeptrace.db

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
MAX_UPLOAD_SIZE_MB=25

# External lookups disclose indicators. Offline is the default.
INTELLIGENCE_MODE=offline
VERIFY_AUTHENTICATION_DNS=false

# External Intelligence APIs (Optional / Graceful degradation if absent)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
SHODAN_API_KEY=
